# Vaultwarden
DOMAIN=https://vault.homelab118.home

# Disable public signups (recommended for private instances)
SIGNUPS_ALLOWED=false

# Admin panel token — generate with: echo -n "yourpassword" | argon2 somesalt -e -id -k 65540 -t 3 -p 4
# Or use a strong random string (less secure but simpler)
ADMIN_TOKEN=
