# WUD — Logging
WUD_LOG_LEVEL=info

# Watcher — Docker local socket
WUD_WATCHER_DOCKER_LOCAL_CRON=0 0 3 * * *
WUD_WATCHER_DOCKER_LOCAL_PRUNE=true

# Trigger — Docker Compose auto-update
WUD_TRIGGER_DOCKERCOMPOSE_AUTO_FILE=/var/run/docker.sock
WUD_TRIGGER_DOCKERCOMPOSE_AUTO_PRUNE=true

# Trigger — Discord notification
WUD_TRIGGER_DISCORD_NOTIFY_ONLY_URL=
WUD_TRIGGER_DISCORD_NOTIFY_ONLY_TITLE=Updates Available
